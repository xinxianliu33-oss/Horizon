{
  "ai": {
    "provider": "gemini",
    "model": "gemini-3.8-flash",
    "api_key_env": "GOOGLE_API_KEY",
    "languages": ["zh"],
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 4,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 5.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "torvalds",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 2
    },
    "twitter": {
      "enabled": true,
      "users": ["karpathy"],
      "keywords": [],
      "fetch_limit": 5,
      "fetch_reply_text": false,
      "profile": "tech-news"
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["Python"],
      "keywords": [],
      "min_stars": 20,
      "max_items": 15,
      "profile": "tech-news"
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 15,
          "profile": ["tech-news"]
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24,
  },
  "digest": {
    "max_items": 25,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ]
  },
  "webhook": {
    "enabled": false
  },
  "wechat": {
    "enabled": false
  }
}
